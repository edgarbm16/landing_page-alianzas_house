---
interface Props {
	phone?: string;
}
const { phone } = Astro.props;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 shadow-sm">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
		<div class="flex items-center justify-between h-16">
			<a href="#hero" class="flex items-center gap-2 shrink-0">
				<img id="nav-logo-img" src="" alt="" class="h-16 md:h-24 object-contain hidden" />
				<span id="nav-logo-text" class="text-gray-900 font-bold text-lg tracking-tight"></span>
			</a>

			<div class="flex items-center gap-3">
				{phone && (
					<a href={`tel:${phone}`} class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors">
						<svg class="w-4 h-4 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.86 15a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.77 4h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 11.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 19.18v2.74z"/>
						</svg>
						{phone}
					</a>
				)}
				<a href="#contacto" class="inline-flex items-center px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition-colors">
					Agendar Cita
				</a>
			</div>
		</div>
	</div>
</header>

<script>
	window.addEventListener('settings-loaded', (e: Event) => {
		const detail      = (e as CustomEvent).detail ?? {};
		const logoUrl     = detail.logo_url    as string | undefined;
		const companyName = detail.company_name as string | undefined;

		const logoImg  = document.getElementById('nav-logo-img')  as HTMLImageElement;
		const logoText = document.getElementById('nav-logo-text') as HTMLElement;

		if (logoUrl) {
			logoImg.src = logoUrl;
			logoImg.alt = companyName || '';
			logoImg.classList.remove('hidden');
		} else if (companyName) {
			logoText.textContent = companyName;
		}
	});
</script>
