---
interface Props {
	h1?: string;
	description?: string;
	hero_url?: string;
	hero_type?: string;
}
const { h1, description, hero_url, hero_type } = Astro.props;
---

<section id="hero" class="pt-16 bg-white">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
			<!-- Left: text -->
			<div class="order-2 lg:order-1">
				<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold uppercase tracking-wide mb-6">
					<span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
					Bienes Raíces Profesionales
				</span>
				<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-6">
					{h1 || 'Tu Hogar Ideal te Está Esperando'}
				</h1>
				<p class="text-lg text-gray-500 leading-relaxed mb-8">
					{description || 'Encuentra la propiedad perfecta para ti y tu familia. Contamos con un portafolio exclusivo de inmuebles residenciales y comerciales en las mejores ubicaciones.'}
				</p>
				<div class="flex flex-col sm:flex-row gap-3 mb-10">
					<a href="#propiedades" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold transition-colors shadow-md shadow-blue-600/20">
						Ver Propiedades
						<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
					<a href="#contacto" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border-2 border-gray-200 hover:border-gray-300 text-gray-700 font-semibold transition-colors">
						Contactar Agente
					</a>
				</div>
				<div class="flex flex-wrap items-center gap-6">
					{['Asesoría sin costo', 'Proceso 100% seguro', 'Atención personalizada'].map(badge => (
						<div class="flex items-center gap-2 text-sm text-gray-500">
							<svg class="w-5 h-5 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
							</svg>
							{badge}
						</div>
					))}
				</div>
			</div>

			<!-- Right: hero image/video -->
			<div class="order-1 lg:order-2 relative">
				{hero_url ? (
					hero_type === 'video' ? (
						<div class="relative rounded-2xl overflow-hidden shadow-2xl aspect-[4/3]">
							<video class="w-full h-full object-cover" autoplay muted loop playsinline>
								<source src={hero_url} type="video/mp4" />
							</video>
						</div>
					) : (
						<div class="relative rounded-2xl overflow-hidden shadow-2xl aspect-[4/3]">
							<img src={hero_url} alt={h1 || 'Propiedad'} class="w-full h-full object-cover" />
						</div>
					)
				) : (
					<div class="relative rounded-2xl overflow-hidden shadow-2xl aspect-[4/3]">
						<img src="https://images.pexels.com/photos/1732414/pexels-photo-1732414.jpeg?auto=compress&cs=tinysrgb&w=900" alt="Propiedades exclusivas" class="w-full h-full object-cover" />
					</div>
				)}
				<div class="absolute -bottom-4 -left-4 bg-white rounded-2xl shadow-xl px-5 py-4 flex items-center gap-3">
					<div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center shrink-0">
						<svg class="w-5 h-5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
						</svg>
					</div>
					<div>
						<p class="text-xs text-gray-400">Propiedades activas</p>
						<p class="text-sm font-bold text-gray-900">+500 inmuebles</p>
					</div>
				</div>
				<div class="absolute -top-6 -right-6 w-32 h-32 rounded-full bg-blue-100 blur-3xl opacity-60 -z-10"></div>
			</div>
		</div>
	</div>
</section>
