---
interface Props {
	badge?: string;
	title: string;
	subtitle?: string;
	align?: 'center' | 'left';
	class?: string;
}
const { badge, title, subtitle, align = 'center', class: className = '' } = Astro.props;
const isCenter = align === 'center';
---

<div class:list={[isCenter && 'text-center max-w-2xl mx-auto', className]}>
	{badge && (
		<span class="inline-block text-blue-600 text-xs font-bold uppercase tracking-widest mb-4">{badge}</span>
	)}
	<h2 class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight">{title}</h2>
	{subtitle && (
		<p class="text-gray-500 leading-relaxed mt-4">{subtitle}</p>
	)}
</div>
