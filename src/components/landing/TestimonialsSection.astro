---
import SectionHeader from './SectionHeader.astro';

const testimonials = [
	{
		name: 'Carlos Hernández',
		role: 'Comprador, CDMX',
		text: 'Encontré la casa de mis sueños en tiempo récord. El equipo me acompañó en cada paso y la asesoría legal fue impecable. 100% recomendados.',
		initials: 'CH',
		color: 'bg-blue-100 text-blue-700',
	},
	{
		name: 'Laura Martínez',
		role: 'Vendedora, Guadalajara',
		text: 'Vendí mi departamento 20% por encima del precio estimado. La estrategia de marketing y la gestión de los agentes fue excelente. Muy satisfecha.',
		initials: 'LM',
		color: 'bg-purple-100 text-purple-700',
	},
	{
		name: 'Roberto Sánchez',
		role: 'Inversionista, Monterrey',
		text: 'Llevo 5 años trabajando con ellos para mi portafolio de propiedades en renta. Profesionalismo, honestidad y resultados. No busco otra opción.',
		initials: 'RS',
		color: 'bg-emerald-100 text-emerald-700',
	},
];
---

<section class="bg-gray-50 py-20 lg:py-28">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<SectionHeader badge="Testimonios" title="Lo que dicen nuestros clientes" class="mb-14" />
		<div class="grid grid-cols-1 md:grid-cols-3 gap-7">
			{testimonials.map(t => (
				<div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col gap-4">
					<div class="flex gap-0.5">
						{Array(5).fill(null).map(() => (
							<svg class="w-4 h-4 text-yellow-400" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
							</svg>
						))}
					</div>
					<p class="text-gray-600 text-sm leading-relaxed flex-1">"{t.text}"</p>
					<div class="flex items-center gap-3 pt-2 border-t border-gray-100">
						<div class={`w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold ${t.color}`}>{t.initials}</div>
						<div>
							<p class="text-sm font-semibold text-gray-900">{t.name}</p>
							<p class="text-xs text-gray-400">{t.role}</p>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
