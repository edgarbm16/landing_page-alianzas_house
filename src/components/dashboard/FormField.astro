---
interface Props {
  label: string;
  hint?: string;
  class?: string;
}
const { label, hint, class: className = '' } = Astro.props;
---
<div class={`flex flex-col gap-1 ${className}`}>
  <label class="text-sm text-gray-300">{label}</label>
  <slot />
  {hint && <p class="text-xs text-gray-500">{hint}</p>}
</div>
