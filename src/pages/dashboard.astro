---
import Layout from '../layouts/Layout.astro';

const supabaseUrl = import.meta.env.SUPABASE_URL;
const supabaseAnonKey = import.meta.env.SUPABASE_KEY;
---

<Layout title="Dashboard">
  <div id="app-data" data-supabase-url={supabaseUrl} data-supabase-key={supabaseAnonKey} class="hidden"></div>

  <!-- Loading state -->
  <div id="app-loader" class="min-h-screen bg-gray-900 flex items-center justify-center">
    <div class="flex flex-col items-center gap-4">
      <div class="w-10 h-10 border-4 border-gray-600 border-t-blue-500 rounded-full animate-spin"></div>
      <p class="text-gray-400 text-sm">Verificando acceso...</p>
    </div>
  </div>

  <!-- Dashboard wrapper (hidden until auth confirmed) -->
  <div id="dashboard-wrapper" class="hidden bg-gray-900 min-h-screen">

    <!-- Sidebar overlay (mobile) -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-gray-900/80 z-30 hidden"></div>

    <!-- Sidebar -->
    <aside
      id="sidebar"
      class="fixed top-0 left-0 z-40 h-full w-64 bg-gray-800 border-r border-gray-700 transition-transform duration-300"
    >
      <div class="flex flex-col h-full py-4 px-3">

        <!-- Company logo / name -->
        <div class="flex items-center gap-3 px-2 mb-6 min-h-[40px]">
          <img id="sidebar-logo" src="" alt="Logo" class="h-8 object-contain hidden" />
          <span id="sidebar-company" class="text-white font-semibold text-base truncate">Panel Admin</span>
        </div>

        <!-- Main navigation -->
        <nav class="flex-1 space-y-1 overflow-y-auto">
          <a href="/dashboard" class="flex items-center gap-3 px-2 py-2 rounded-lg bg-gray-700 text-white font-medium text-sm">
            <!-- chart-bar -->
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
            </svg>
            Resumen
          </a>

          <a href="/dashboard/prospects" class="flex items-center gap-3 px-2 py-2 rounded-lg text-gray-300 hover:bg-gray-700 hover:text-white transition-colors text-sm">
            <!-- users -->
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
            </svg>
            Prospectos
          </a>

          <a href="/dashboard/landings" class="flex items-center gap-3 px-2 py-2 rounded-lg text-gray-300 hover:bg-gray-700 hover:text-white transition-colors text-sm">
            <!-- globe -->
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.56-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.56.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z" clip-rule="evenodd"/>
            </svg>
            Landings
          </a>

          <a id="nav-emails" href="/dashboard/emails" class="hidden items-center gap-3 px-2 py-2 rounded-lg text-gray-300 hover:bg-gray-700 hover:text-white transition-colors text-sm">
            <!-- mail -->
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
            </svg>
            Correos
          </a>

          <a id="nav-users" href="/dashboard/users" class="hidden items-center gap-3 px-2 py-2 rounded-lg text-gray-300 hover:bg-gray-700 hover:text-white transition-colors text-sm">
            <!-- user -->
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
            </svg>
            Usuarios
          </a>

          <a id="nav-settings" href="/dashboard/settings" class="hidden items-center gap-3 px-2 py-2 rounded-lg text-gray-300 hover:bg-gray-700 hover:text-white transition-colors text-sm">
            <!-- cog -->
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/>
            </svg>
            Configuración
          </a>
        </nav>

        <!-- Bottom: user + logout -->
        <div class="pt-4 border-t border-gray-700 space-y-2">
          <p id="sidebar-user-email" class="px-2 text-xs text-gray-400 truncate"></p>
          <button
            id="logout-btn"
            class="flex cursor-pointer w-full items-center gap-3 px-2 py-2 rounded-lg text-gray-300 hover:bg-gray-700 hover:text-white transition-colors text-sm"
          >
            <!-- logout -->
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd"/>
            </svg>
            Cerrar sesión
          </button>
        </div>

      </div>
    </aside>

    <!-- Main content area -->
    <div id="main-area" class="transition-all duration-300">

      <!-- Top navbar -->
      <nav class="fixed top-0 right-0 z-30 h-16 bg-gray-800 border-b border-gray-700 flex items-center px-4 gap-4" id="top-navbar">
        <!-- Hamburger (visible on mobile) -->
        <button id="sidebar-toggle" class="text-gray-400 hover:text-white md:hidden">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
          </svg>
        </button>

        <p class="text-white font-semibold text-sm flex-1">Resumen general</p>

        <span id="nav-user-name" class="hidden sm:block text-sm text-white font-medium truncate max-w-xs"></span>
      </nav>

      <!-- Page content -->
      <main class="pt-20 px-4 md:px-6 space-y-6">

        <!-- KPI Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">

          <div class="bg-gray-800 rounded-lg p-4 shadow">
            <p class="text-sm text-gray-400 mb-2">Total de prospectos</p>
            <p id="kpi-prospects" class="text-3xl font-bold text-white mb-2">—</p>
            <div class="flex items-center gap-1.5 text-sm text-gray-400">
              <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
              </svg>
              Leads capturados
            </div>
          </div>

          <div class="bg-gray-800 rounded-lg p-4 shadow">
            <p class="text-sm text-gray-400 mb-2">Prospectos este mes</p>
            <p id="kpi-month" class="text-3xl font-bold text-white mb-2">—</p>
            <div class="flex items-center gap-1.5 text-sm text-green-400">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
              <span id="kpi-month-label">Mes en curso</span>
            </div>
          </div>

          <div class="bg-gray-800 rounded-lg p-4 shadow">
            <p class="text-sm text-gray-400 mb-2">Landings publicadas</p>
            <p id="kpi-landings" class="text-3xl font-bold text-white mb-2">—</p>
            <div class="flex items-center gap-1.5 text-sm text-gray-400">
              <svg class="w-4 h-4 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.56-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.56.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z" clip-rule="evenodd"/>
              </svg>
              Páginas activas
            </div>
          </div>

        </div>

        <!-- Recent Prospects Table -->
        <div class="bg-gray-800 rounded-lg shadow overflow-hidden">

          <!-- Table header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-5 border-b border-gray-700">
            <p class="text-lg font-bold text-white">Prospectos recientes</p>
            <a href="/dashboard/prospects" class="inline-flex items-center gap-1 text-sm font-medium text-blue-500 hover:underline">
              Ver todos
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>

          <!-- Table -->
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead>
                <tr class="text-xs font-medium text-gray-400 uppercase bg-gray-700/40 border-b border-gray-700">
                  <th class="px-5 py-3">Nombre</th>
                  <th class="px-5 py-3">Email</th>
                  <th class="px-5 py-3 hidden sm:table-cell">Teléfono</th>
                  <th class="px-5 py-3 hidden md:table-cell">Landing</th>
                  <th class="px-5 py-3">Fecha</th>
                </tr>
              </thead>
              <tbody id="prospects-tbody" class="divide-y divide-gray-700">
                <tr>
                  <td colspan="5" class="px-5 py-10 text-center text-gray-500">Cargando...</td>
                </tr>
              </tbody>
            </table>
          </div>

        </div>

        <!-- Top Landings -->
        <div class="bg-gray-800 rounded-lg shadow overflow-hidden">

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-5 border-b border-gray-700">
            <p class="text-lg font-bold text-white">Top landings por prospectos</p>
            <a href="/dashboard/landings" class="inline-flex items-center gap-1 text-sm font-medium text-blue-500 hover:underline">
              Ver todas
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead>
                <tr class="text-xs font-medium text-gray-400 uppercase bg-gray-700/40 border-b border-gray-700">
                  <th class="px-5 py-3">Landing</th>
                  <th class="px-5 py-3 hidden sm:table-cell">Slug</th>
                  <th class="px-5 py-3">Estado</th>
                  <th class="px-5 py-3 text-right">Prospectos</th>
                </tr>
              </thead>
              <tbody id="landings-tbody" class="divide-y divide-gray-700">
                <tr>
                  <td colspan="4" class="px-5 py-10 text-center text-gray-500">Cargando...</td>
                </tr>
              </tbody>
            </table>
          </div>

        </div>

      </main>
    </div>
  </div>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  function esc(s: any): string {
    return (s ?? '').toString()
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // ── DOM refs ───────────────────────────────────────────────
  const appData        = document.getElementById('app-data') as HTMLElement;
  const appLoader      = document.getElementById('app-loader') as HTMLElement;
  const dashWrapper    = document.getElementById('dashboard-wrapper') as HTMLElement;
  const sidebar        = document.getElementById('sidebar') as HTMLElement;
  const sidebarOverlay = document.getElementById('sidebar-overlay') as HTMLElement;
  const sidebarToggle  = document.getElementById('sidebar-toggle') as HTMLButtonElement;
  const mainArea       = document.getElementById('main-area') as HTMLElement;
  const topNavbar      = document.getElementById('top-navbar') as HTMLElement;
  const logoutBtn      = document.getElementById('logout-btn') as HTMLButtonElement;
  const navEmails      = document.getElementById('nav-emails') as HTMLElement;
  const navUsers       = document.getElementById('nav-users') as HTMLElement;
  const navSettings    = document.getElementById('nav-settings') as HTMLElement;
  const sidebarEmail   = document.getElementById('sidebar-user-email') as HTMLElement;
  const navUserName    = document.getElementById('nav-user-name') as HTMLElement;
  const kpiProspects   = document.getElementById('kpi-prospects') as HTMLElement;
  const kpiMonth       = document.getElementById('kpi-month') as HTMLElement;
  const kpiLandings    = document.getElementById('kpi-landings') as HTMLElement;
  const prospectsTbody = document.getElementById('prospects-tbody') as HTMLElement;
  const landingsTbody  = document.getElementById('landings-tbody') as HTMLElement;

  const supabaseUrl = appData?.dataset.supabaseUrl;
  const supabaseKey = appData?.dataset.supabaseKey;

  if (!supabaseUrl || !supabaseKey) {
    window.location.href = '/login';
  } else {
    const supabase = createClient(supabaseUrl, supabaseKey);

    // ── Sidebar responsive layout ────────────────────────────
    function applyLayout() {
      const isDesktop = window.innerWidth >= 768;
      if (isDesktop) {
        sidebar.style.removeProperty('transform');
        mainArea.style.marginLeft = '256px';
        topNavbar.style.left = '256px';
      } else {
        if (!sidebar.classList.contains('sidebar-open')) {
          sidebar.style.transform = 'translateX(-100%)';
        }
        mainArea.style.marginLeft = '0';
        topNavbar.style.left = '0';
      }
    }

    function openSidebar() {
      sidebar.style.transform = 'translateX(0)';
      sidebar.classList.add('sidebar-open');
      sidebarOverlay.classList.remove('hidden');
    }

    function closeSidebar() {
      sidebar.style.transform = 'translateX(-100%)';
      sidebar.classList.remove('sidebar-open');
      sidebarOverlay.classList.add('hidden');
    }

    sidebarToggle?.addEventListener('click', () => {
      sidebar.classList.contains('sidebar-open') ? closeSidebar() : openSidebar();
    });

    sidebarOverlay?.addEventListener('click', closeSidebar);
    window.addEventListener('resize', applyLayout);

    // ── Settings: logo + company name in sidebar ─────────────
    window.addEventListener('settings-loaded', ((e: CustomEvent) => {
      const { company_name, logo_url } = e.detail;
      const logoEl   = document.getElementById('sidebar-logo') as HTMLImageElement;
      const nameEl   = document.getElementById('sidebar-company') as HTMLElement;
      if (logoEl && logo_url) {
        logoEl.src = logo_url;
        logoEl.classList.remove('hidden');
      }
      if (nameEl && company_name) {
        nameEl.textContent = company_name;
      }
    }) as EventListener);

    // ── Logout ───────────────────────────────────────────────
    logoutBtn?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      localStorage.removeItem('supabase_session');
      window.location.href = '/login';
    });

    // ── Data loaders ─────────────────────────────────────────
    async function loadKPIs() {
      const now   = new Date();
      const start = new Date(now.getFullYear(), now.getMonth(), 1).toISOString();

      const [
        { count: totalProspects },
        { count: monthProspects },
        { count: publishedLandings },
      ] = await Promise.all([
        supabase.from('prospects').select('*', { count: 'exact', head: true }),
        supabase.from('prospects').select('*', { count: 'exact', head: true }).gte('created_at', start),
        supabase.from('landings').select('*', { count: 'exact', head: true }).eq('published', true),
      ]);

      kpiProspects.textContent = totalProspects?.toString() ?? '0';
      kpiMonth.textContent     = monthProspects?.toString() ?? '0';
      kpiLandings.textContent  = publishedLandings?.toString() ?? '0';

      const monthName = now.toLocaleDateString('es-MX', { month: 'long' });
      const label = document.getElementById('kpi-month-label');
      if (label) label.textContent = monthName.charAt(0).toUpperCase() + monthName.slice(1);
    }

    async function loadRecentProspects() {
      const { data, error } = await supabase
        .from('prospects')
        .select('*, landings(name, slug)')
        .order('created_at', { ascending: false })
        .limit(10);

      if (error || !data?.length) {
        prospectsTbody.innerHTML = `
          <tr><td colspan="5" class="px-5 py-10 text-center text-gray-500">
            ${error ? 'Error al cargar prospectos' : 'Sin prospectos registrados'}
          </td></tr>`;
        return;
      }

      prospectsTbody.innerHTML = data.map(p => `
        <tr class="hover:bg-gray-700/30 transition-colors">
          <td class="px-5 py-3 text-white font-medium whitespace-nowrap">${esc(p.name ?? '—')}</td>
          <td class="px-5 py-3 text-gray-300">${esc(p.email ?? '—')}</td>
          <td class="px-5 py-3 text-gray-300 hidden sm:table-cell">${esc(p.phone ?? '—')}</td>
          <td class="px-5 py-3 hidden md:table-cell">
            ${p.landings
              ? `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-900/40 text-blue-300">${esc(p.landings.name)}</span>`
              : '<span class="text-gray-500">—</span>'}
          </td>
          <td class="px-5 py-3 text-gray-400 whitespace-nowrap text-xs">
            ${new Date(p.created_at).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' })}
          </td>
        </tr>
      `).join('');
    }

    async function loadTopLandings() {
      const { data, error } = await supabase
        .from('prospects')
        .select('landing_id, landings(name, slug, published)');

      if (error || !data?.length) {
        landingsTbody.innerHTML = `
          <tr><td colspan="4" class="px-5 py-10 text-center text-gray-500">Sin datos disponibles</td></tr>`;
        return;
      }

      const counts: Record<string, { name: string; slug: string; published: boolean; count: number }> = {};
      for (const row of data) {
        if (row.landing_id && row.landings) {
          if (!counts[row.landing_id]) {
            counts[row.landing_id] = { ...(row.landings as any), count: 0 };
          }
          counts[row.landing_id].count++;
        }
      }

      const sorted = Object.values(counts).sort((a, b) => b.count - a.count).slice(0, 5);

      if (!sorted.length) {
        landingsTbody.innerHTML = `
          <tr><td colspan="4" class="px-5 py-10 text-center text-gray-500">Sin datos disponibles</td></tr>`;
        return;
      }

      landingsTbody.innerHTML = sorted.map(l => `
        <tr class="hover:bg-gray-700/30 transition-colors">
          <td class="px-5 py-3 text-white font-medium">${esc(l.name)}</td>
          <td class="px-5 py-3 text-gray-400 font-mono text-xs hidden sm:table-cell">/${esc(l.slug)}</td>
          <td class="px-5 py-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${
              l.published
                ? 'bg-green-900/40 text-green-400'
                : 'bg-yellow-900/40 text-yellow-400'
            }">
              ${l.published ? 'Publicada' : 'Borrador'}
            </span>
          </td>
          <td class="px-5 py-3 text-right text-white font-semibold">${l.count}</td>
        </tr>
      `).join('');
    }

    // ── Auth check ───────────────────────────────────────────
    async function checkAuth() {
      try {
        const { data: { session }, error } = await supabase.auth.getSession();
        if (error || !session) { window.location.href = '/login'; return; }

        // Show user info
        const email = session.user.email ?? '';
        if (sidebarEmail) sidebarEmail.textContent = email;

        // Role-based nav visibility + full_name
        const { data: profile } = await supabase
          .from('user_profiles')
          .select('role, full_name')
          .eq('id', session.user.id)
          .maybeSingle();

        const displayName = (profile as any)?.full_name
          ?? (session.user.user_metadata?.full_name as string | undefined)
          ?? email.split('@')[0];
        if (navUserName) navUserName.textContent = displayName;

        if (profile && ['Administrador', 'Gestor'].includes(profile.role)) {
          navUsers?.classList.replace('hidden', 'flex');
        }

        const [{ data: hasEmails }, { data: hasSettings }] = await Promise.all([
          supabase.rpc('has_module_permission', { user_id: session.user.id, module: 'emails' }),
          supabase.rpc('has_module_permission', { user_id: session.user.id, module: 'settings' }),
        ]);

        if (hasEmails)   navEmails?.classList.replace('hidden', 'flex');
        if (hasSettings) navSettings?.classList.replace('hidden', 'flex');

        // Load data in parallel
        await Promise.all([loadKPIs(), loadRecentProspects(), loadTopLandings()]);

        // Reveal dashboard
        appLoader.classList.add('hidden');
        dashWrapper.classList.remove('hidden');
        applyLayout();

      } catch {
        window.location.href = '/login';
      }
    }

    checkAuth();
  }
</script>
